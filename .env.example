# Node reads these from its process environment.
PORT=4310
DATA_DIR=.data
# Optional for repeatable tests
# DEMO_CLOCK=manual
# For the separate hosted simulator
# SITE_URL=https://your-site.example
# RELAY_DIR=.data-relay
# DEMO_PORT=4321
# RELAY_SECRET must match the secret configured for the Site.

# Optional owner-only Ready manager pilot. Keep the actual values out of Git.
# LIVE_MANAGER_ENABLED=true
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# LIVE_MANAGER_TOOL_SECRET= [generate at least 32 random characters]
# LIVE_MANAGER_API_ORIGIN=http://127.0.0.1:4310
# OPENAI_API_KEY=
# ANAM_API_KEY=
# ANAM_AVATAR_ID=
